{
    "info": {
      "name": "Incident Reports",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
      {
        "name": "Get all incident reports",
        "request": {
          "method": "GET",
          "header": [],
          "url": { "raw": "{{baseUrl}}/incident-reports", "host": ["{{baseUrl}}"], "path": ["incident-reports"] }
        }
      },
      {
        "name": "Get incident report by ID",
        "request": {
          "method": "GET",
          "header": [],
          "url": { "raw": "{{baseUrl}}/incident-reports/1", "host": ["{{baseUrl}}"], "path": ["incident-reports", "1"] }
        }
      },
      {
        "name": "Create incident report",
        "request": {
          "method": "POST",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"deviceId\": 1,\n  \"reportedBy\": 1,\n  \"description\": \"Lỗi hoạt động bất thường\"\n}"
          },
          "url": { "raw": "{{baseUrl}}/incident-reports", "host": ["{{baseUrl}}"], "path": ["incident-reports"] }
        }
      },
      {
        "name": "Update incident status",
        "request": {
          "method": "PUT",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"status\": \"resolved\"\n}"
          },
          "url": { "raw": "{{baseUrl}}/incident-reports/1/status", "host": ["{{baseUrl}}"], "path": ["incident-reports", "1", "status"] }
        }
      },
      {
        "name": "Delete incident report",
        "request": {
          "method": "DELETE",
          "header": [],
          "url": { "raw": "{{baseUrl}}/incident-reports/1", "host": ["{{baseUrl}}"], "path": ["incident-reports", "1"] }
        }
      }
    ]
  }
  